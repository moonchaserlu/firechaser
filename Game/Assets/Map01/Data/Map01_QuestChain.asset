  m_Name: Map01_QuestChain
  m_EditorClassIdentifier: WildernessExtraction.Map01::WildernessExtraction.Map01.Map01QuestChain
  quests:
  - questId: Q01
    title: "\u706B\u4E0D\u80FD\u706D"
    goal: "\u5728\u5E87\u62A4\u6240\u9644\u8FD1\u7684\u7269\u8D44\u70B9\u627E\u5230\u71C3\u6599\uFF0C\u5E26\u56DE\u5E87\u62A4\u6240\u3002"
    completionFact: fuel_delivered
    steps:
    - "\u53BB\u5E87\u62A4\u6240\u4E1C\u4FA7\u5916\u5899\u8FB9\u7684\u7269\u8D44\u5806\u627E\u4E00\u4EFD\u71C3\u6599"
    - "\u56DE\u5230\u5E87\u62A4\u6240\uFF0C\u5728\u7089\u706B\u65C1\u6309 E \u6DFB\u71C3\u6599"
    completionText: "\u7089\u706B\u7EED\u4E0A\u4E86\u3002\u8FD9\u95F4\u5E9F\u5F03\u5E87\u62A4\u6240\u6682\u65F6\u53EF\u4EE5\u843D\u811A\u3002"
  - questId: Q02
    title: "\u8BA9\u8FD9\u91CC\u4EAE\u8D77\u6765"
    goal: "\u53BB\u5382\u623F\u53D6\u5F97\u673A\u68B0\u96F6\u4EF6\u3001\u4FEE\u590D\u53D1\u7535\u673A\uFF0C\u7ED9\u7A7A\u7535\u6C60\u5145\u7535\u5E76\u5E26\u56DE\u5B89\u88C5\u3002"
    completionFact: safehouse_lit
    steps:
    - "\u53BB\u5382\u623F\uFF08\u897F\u5317\u65B9\u5411\uFF09\u627E\u5230\u673A\u68B0\u96F6\u4EF6"
    - "\u5230\u5382\u623F\u53D1\u7535\u673A\u623F\uFF0C\u6309 E \u4FEE\u7406\u53D1\u7535\u673A"
    - "\u4FEE\u7406\u4E2D\uFF0C\u7559\u5728\u53D1\u7535\u673A\u65C1"
    - "\u62FF\u4E0A\u7A7A\u7535\u6C60\uFF08\u5E87\u62A4\u6240\u5317\u5899\u8FB9\u7684\u7BB1\u5B50\u91CC\u6709\u4E00\u5757\uFF09"
    - "\u5728\u53D1\u7535\u673A\u65C1\u6309 E \u7ED9\u7A7A\u7535\u6C60\u5145\u7535\uFF08\u53D1\u7535\u673A\u4FEE\u597D\u540E\u6BCF 30 \u79D2\u5B58 1 \u683C\u7535\uFF09"
    - "\u628A\u5145\u597D\u7684\u7535\u6C60\u5E26\u56DE\u5E87\u62A4\u6240\uFF0C\u88C5\u8FDB\u4F9B\u7535\u69FD"
    completionText: "\u5E87\u62A4\u6240\u6062\u590D\u7167\u660E\u3002"
  - questId: Q03
    title: "\u5907\u4E00\u70B9\u836F"
    goal: "\u641C\u7D22\u5382\u623F\u5269\u4F59\u7269\u8D44\uFF0C\u5E26\u56DE\u4E00\u4EFD\u533B\u7597\u7528\u54C1\u3002"
    completionFact: medical_confirmed
    steps:
    - "\u5728\u5382\u623F\u627E\u4E00\u4EFD\u533B\u7597\u7528\u54C1"
    - "\u56DE\u5230\u5E87\u62A4\u6240\uFF0C\u5728\u7089\u706B\u65C1\u6309 E \u6E05\u70B9\u836F\u54C1"
    completionText: "\u836F\u54C1\u5907\u597D\u4E86\uFF0C\u7559\u7740\u4E0B\u6B21\u8FDC\u884C\u7528\u3002"
  - questId: Q04
    title: "\u524D\u4EBA\u7559\u4E0B\u7684\u4E1C\u897F"
    goal: "\u67E5\u770B\u5E87\u62A4\u6240\u91CC\u7684\u65E7\u8BB0\u5F55\u3002"
    completionFact: record:map01_safehouse_log
    steps:
    - "\u67E5\u770B\u5E87\u62A4\u6240\u897F\u5899\u8FB9\u7684\u65E7\u8BB0\u5F55"
    completionText: "\u53E6\u4E00\u540D\u5BFB\u706B\u8005\u66FE\u5728\u8FD9\u91CC\u505C\u7559\uFF0C\u540E\u6765\u53BB\u4E86\u6811\u6797\u3002"
  - questId: Q05
    title: "\u6797\u4E2D\u7684\u4F59\u70EC"
    goal: "\u524D\u5F80\u6811\u6797\uFF0C\u5728\u7184\u706D\u7684\u65E7\u706B\u5806\u65C1\u5BFB\u627E\u9057\u7559\u7B14\u8BB0\u3002"
    completionFact: record:map01_forest_note
    steps:
    - "\u53BB\u897F\u8FB9\u7684\u6811\u6797\uFF0C\u5728\u7184\u706D\u7684\u65E7\u706B\u5806\u65C1\u627E\u7B14\u8BB0"
    completionText: "\u90A3\u540D\u5BFB\u706B\u8005\u51C6\u5907\u8FC7\u6865\uFF0C\u53BB\u623F\u533A\u5BFB\u627E\u77E5\u60C5\u4EBA\u3002"
  - questId: Q06
    title: "\u5230\u6865\u90A3\u8FB9\u53BB"
    goal: "\u5230\u8FBE\u6865\u5934\uFF0C\u907F\u5F00\u6216\u51FB\u8D25\u9644\u8FD1\u602A\u7269\uFF0C\u7A7F\u8FC7\u6865\u6881\u3002"
    completionFact: crossed_bridge
    steps:
    - "\u8FC7\u6865\u62B5\u8FBE\u6CB3\u5BF9\u5CB8\uFF08\u6865\u5934\u53EF\u80FD\u6709\u602A\u7269\uFF0C\u53EF\u4EE5\u7ED5\u5F00\uFF09"
    completionText: "\u5230\u4E86\u6CB3\u5BF9\u5CB8\uFF0C\u63A5\u4E0B\u6765\u53BB\u623F\u533A\u3002"
  - questId: Q07
    title: "\u7A7A\u5C4B\u91CC\u7684\u6D88\u606F"
    goal: "\u641C\u7D22\u623F\u533A\u4E2D\u53EF\u8FDB\u5165\u7684\u4F4F\u5B85\uFF0C\u627E\u5230\u4F4F\u5BA2\u8BB0\u5F55\u3002"
    completionFact: record:map01_house_note
    steps:
    - "\u53BB\u4E1C\u8FB9\u623F\u533A\u552F\u4E00\u80FD\u8FDB\u7684\u4F4F\u5B85\uFF0C\u627E\u5230\u4F4F\u5BA2\u8BB0\u5F55"
    completionText: "\u6709\u4EBA\u8FD0\u9001\u8FC7\u7591\u4F3C\u5723\u706B\u7684\u706B\u79CD\uFF0C\u66FE\u5728\u4ED3\u5E93\u505C\u7559\u3002"
  - questId: Q08
    title: "\u4E3A\u8FD4\u7A0B\u7559\u4E00\u76CF\u706B"
    goal: "\u5728\u6865\u9644\u8FD1\u7684\u53EF\u653E\u7F6E\u4F4D\u7F6E\u5EFA\u8D77\u4E00\u5806\u706B\u3002"
    completionFact: campfire_at_bridge
    steps:
    - "\u627E\u4E00\u4EFD\u71C3\u6599\uFF08\u6865\u5317\u5934\u9644\u8FD1\u6709\u4E00\u4EFD\uFF09"
    - "\u5728\u6865\u5317\u5934\u897F\u4FA7\u7A7A\u5730\u6309 Q \u5EFA\u4E00\u5806\u706B"
    completionText: "\u706B\u5806\u70B9\u7740\u4E86\u3002\u5B83\u4F1A\u71C3\u5C3D\uFF0C\u522B\u6307\u671B\u5B83\u5B88\u4E00\u6574\u591C\u3002"
  - questId: Q09
    title: "\u5BFB\u627E\u8FD0\u9001\u8BB0\u5F55"
    goal: "\u8FDB\u5165\u4ED3\u5E93\uFF0C\u627E\u5230\u706B\u79CD\u7684\u8D27\u5355\u6216\u968F\u884C\u8BB0\u5F55\u3002"
    completionFact: record:map01_warehouse_manifest
    steps:
    - "\u53BB\u897F\u8FB9\u7684\u4ED3\u5E93\uFF0C\u5728\u4E1C\u4FA7\u8D27\u7BB1\u65C1\u627E\u8FD0\u9001\u8BB0\u5F55"
    completionText: "\u627E\u5230\u4E86\u8FD0\u9001\u8005\u548C\u4ED6\u4EEC\u7684\u4E0B\u4E00\u7AD9\u3002"
  - questId: Q10
    title: "\u4E0B\u4E00\u6BB5\u8DEF"
    goal: "\u628A\u8FD0\u9001\u8BB0\u5F55\u5E26\u56DE\u5E87\u62A4\u6240\uFF0C\u4E0E\u65E7\u5730\u56FE\u5BF9\u7167\u3002"
    completionFact: map_compared
    steps:
    - "\u56DE\u5230\u5E87\u62A4\u6240\uFF0C\u5728\u4E1C\u5899\u7684\u65E7\u5730\u56FE\u524D\u6309 E \u5BF9\u7167\u8FD0\u9001\u8BB0\u5F55"
    completionText: "\u4F60\u5728\u65E7\u5730\u56FE\u4E0A\u6807\u51FA\u4E86\u8FD0\u9001\u961F\u7684\u53BB\u5411\u3002"
  records:
  - recordId: map01_safehouse_log
    title: "\u5B88\u591C\u8BB0\u5F55\uFF08\u6495\u4E0B\u7684\u51E0\u9875\uFF09"
    body: "\u2026\u2026\u71C3\u6599\u53EA\u591F\u518D\u70E7\u51E0\u591C\uFF0C\u6211\u628A\u6700\u540E\u4E00\u70B9\u5012\u8FDB\u4E86\u7089\u5B50\u3002\n\n\u4E1C\u8FB9\u5382\u623F\u7684\u53D1\u7535\u673A\u8FD8\u80FD\u4FEE\uFF0C\u96F6\u4EF6\u5F97\u53BB\u91CC\u9762\u7FFB\u3002\u4FEE\u597D\u4E86\u8FD9\u91CC\u5C31\u80FD\u4EAE\u706F\u3002\n\n\u6211\u4E0D\u7B49\u4E86\u3002\u6811\u6797\u90A3\u8FB9\u6709\u4EBA\u751F\u8FC7\u706B\uFF0C\u70DF\u5F80\u897F\u98D8\u3002\u6211\u53BB\u770B\u770B\u662F\u8C01\u3002\n\n\u2014\u2014\u4E00\u4E2A\u8DEF\u8FC7\u7684\u5BFB\u706B\u8005"
    position: {x: 190.8, y: 0, z: -122.1}
    fact: record:map01_safehouse_log
  - recordId: map01_forest_note
    title: "\u538B\u5728\u77F3\u5934\u4E0B\u7684\u7B14\u8BB0"
    body: "\u706B\u662F\u6211\u751F\u7684\uFF0C\u4E5F\u662F\u6211\u7184\u7684\u3002\u71C3\u6599\u8981\u7701\u7740\u7528\u3002\n\n\u542C\u4EBA\u8BF4\uFF0C\u6865\u90A3\u8FB9\u7684\u623F\u533A\u8FD8\u6709\u4EBA\u4F4F\u8FC7\uFF0C\u89C1\u8FC7\u4E00\u53EA\u900F\u7740\u5149\u7684\u94C1\u7BB1\u88AB\u4EBA\u63A8\u7740\u8D70\u3002\u6709\u4EBA\u7BA1\u90A3\u53EB\u5723\u706B\u3002\n\n\u6211\u8981\u8FC7\u6865\u53BB\u627E\u77E5\u60C5\u7684\u4EBA\u3002\u770B\u5230\u8FD9\u5F20\u7EB8\u7684\u4EBA\uFF0C\u522B\u5728\u6797\u5B50\u91CC\u8FC7\u591C\u3002"
    position: {x: -84, y: 0, z: 11}
    fact: record:map01_forest_note
  - recordId: map01_house_note
    title: "\u4F4F\u5BA2\u7684\u65E5\u8BB0"
    body: "\u7B2C\u4E09\u5341\u4E00\u5929\u3002\n\n\u4E00\u961F\u4EBA\u63A8\u7740\u677F\u8F66\u4ECE\u6865\u90A3\u8FB9\u8FC7\u6765\uFF0C\u8F66\u4E0A\u4E00\u53EA\u94C1\u7BB1\uFF0C\u7F1D\u91CC\u900F\u7740\u5149\uFF0C\u4E0D\u51B7\u4E0D\u70ED\uFF0C\u50CF\u7089\u819B\u3002\n\n\u9886\u5934\u7684\u8BF4\u90A3\u662F\u5723\u706B\u7684\u706B\u79CD\uFF0C\u8981\u5F80\u5317\u9001\u3002\u4ED6\u4EEC\u5728\u897F\u8FB9\u4ED3\u5E93\u6B47\u4E86\u4E00\u665A\u3002\n\n\u6211\u6CA1\u6562\u591A\u95EE\u3002\u662F\u771F\u662F\u5047\uFF0C\u8C01\u77E5\u9053\u5462\u3002"
    position: {x: 179.4, y: 0, z: 112.2}
    fact: record:map01_house_note
  - recordId: map01_warehouse_manifest
    title: "\u8FD0\u9001\u8BB0\u5F55"
    body: "\u8D27\u7269\uFF1A\u5BC6\u5C01\u94C1\u7BB1\u4E00\u53EA\uFF08\u201C\u706B\u79CD\u201D\uFF0C\u52FF\u5F00\uFF09\n\u62BC\u8FD0\uFF1A\u3014\u8FD0\u9001\u8005\u59D3\u540D\u5F85\u5B9A\u3015\n\u7ECF\u505C\uFF1A\u897F\u5CB8\u4ED3\u5E93\uFF0C\u4E00\u591C\n\u4E0B\u4E00\u7AD9\uFF1A\u3014\u5317\u65B9\u76EE\u7684\u5730\u5F85\u5B9A\u3015\n\n\u80CC\u9762\u6F66\u8349\u5730\u5199\u7740\uFF1A\u5982\u679C\u706B\u79CD\u662F\u771F\u7684\uFF0C\u6240\u6709\u4EBA\u90FD\u4F1A\u6765\u62A2\u3002\u522B\u5199\u5728\u660E\u9762\u4E0A\u3002"
    position: {x: -76, y: 0, z: 125}
    fact: record:map01_warehouse_manifest
